{
  "name": "telegram-shop-digital-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram shop digital MVP: catalog → Buy Now → VietQR → SePay → secure delivery",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@10",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/property tests/security tests/contract",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "vitest run tests/acceptance",
    "test:performance": "vitest run tests/performance",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs && node scripts/write-build-identity.mjs",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx src/main.ts",
    "dev:worker": "tsx src/worker.ts",
    "migrate": "tsx src/infrastructure/db/migrate.ts",
    "wallet:reconcile": "tsx scripts/wallet-reconciliation.ts",
    "migrate:prod": "node dist/infrastructure/db/migrate.js",
    "migrate:production": "node scripts/run-production-migrate.mjs",
    "preflight:production": "node scripts/run-production-preflight.mjs",
    "admin:step-up": "node scripts/admin-step-up.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "verify:gate": "node scripts/verify-gate.mjs",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "grammy": "^1.46.0",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "ulid": "^3.0.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.1",
    "fast-check": "^4.10.0",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10"
  }
}
