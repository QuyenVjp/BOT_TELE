# Telegram Shop Digital MVP — environment template
# Copy to .env for local development. NEVER commit real secrets.
# Production startup fails closed if a required value is missing.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# --- HTTP ingress ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
HTTP_BODY_LIMIT_BYTES=65536

# --- PostgreSQL (source of truth) ---
DATABASE_URL=postgres://shop:shop@localhost:5432/shop

# --- Redis (ephemeral only: rate limit / cache / job coordination) ---
# Optional in MVP. Leave empty to use in-process fallbacks.
REDIS_URL=

# --- Telegram (adapter) ---
# Placeholder token; production fails closed if missing/invalid.
TELEGRAM_BOT_TOKEN=000000000:TEST_PLACEHOLDER_TOKEN_DO_NOT_USE
TELEGRAM_WEBHOOK_SECRET=local-dev-webhook-secret-change-me
BUY_NOW_CALLBACK_HMAC_KEY=$$JP3U68Q14H9Y:L$$
SOCIAL_PROOF_HMAC_KEY=
SOCIAL_PROOF_ENABLED=false
VERIFIED_REVIEWS_ENABLED=false
PROMOTIONS_ENABLED=false
REFERRAL_ATTRIBUTION_ENABLED=false
PAYMENT_REMINDERS_ENABLED=false
GROWTH_DIGEST_ENABLED=false
ADMIN_PAYMENT_ALERT_MODE=OFF
REFERRAL_REWARDS_ENABLED=false
# Rotation model: one active version only. Rotating the key/version intentionally
# invalidates outstanding short-lived callbacks; there is no multi-key verify ring.
BUY_NOW_CALLBACK_KEY_VERSION=1
# Production accepts at most 86400 seconds (24 hours); keep this short-lived.
BUY_NOW_CALLBACK_TTL_SECONDS=900
BUY_NOW_CALLBACK_CLOCK_SKEW_SECONDS=5
DELIVERY_SESSION_HMAC_KEY=local-dev-delivery-session-key-change-me-32bytes
DELIVERY_SESSION_KEY_VERSION=1
DELIVERY_SESSION_PREVIOUS_HMAC_KEY=
DELIVERY_SESSION_PREVIOUS_KEY_VERSION=
DELIVERY_SESSION_PREVIOUS_KEY_GRACE_UNTIL=
DELIVERY_SESSION_TTL_SECONDS=900
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# --- Root admin identity (numeric Telegram user_id ONLY authorizes) ---
ADMIN_TELEGRAM_USER_ID=0
# Display / drift-alert only. NEVER used to authorize.
ADMIN_EXPECTED_USERNAME=Quyenvjp
# Production must set `required` or the owner-approved `disabled` mode explicitly.
ADMIN_STEP_UP_MODE=disabled

# --- SePay (payment verification + reconciliation) ---
SEPAY_WEBHOOK_HMAC_SECRET=local-dev-sepay-hmac-secret-change-me
SEPAY_REPLAY_WINDOW_SECONDS=300
SEPAY_MERCHANT_ACCOUNT_ID=LOCAL-TEST-ACCOUNT
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
SEPAY_API_TOKEN=
SEPAY_IP_ALLOWLIST=
# Comma-separated direct proxy peers whose X-Forwarded-For may be trusted.
SEPAY_TRUSTED_PROXY_IPS=

# --- VietQR presentation ---
VIETQR_BANK_BIN=970422
VIETQR_BANK_ALIAS=MB
VIETQR_ACCOUNT_NUMBER=0000000000
VIETQR_ACCOUNT_NAME=SHOP DIGITAL
VIETQR_BANK_NAME=MB Bank

# --- Payment / order timing ---
PAYMENT_INTENT_TTL_SECONDS=900
DELIVERY_BUNDLE_TTL_SECONDS=86400

WALLET_TOPUP_MIN_VND=50000
WALLET_TOPUP_MAX_VND=1000000

# --- Vault (raw credential boundary) ---
# memory = in-process test adapter. Production requires an approved manager.
VAULT_DRIVER=memory
VAULT_ENDPOINT=
VAULT_TOKEN=
VAULT_NAMESPACE=telegram-shop
VAULT_TIMEOUT_MS=5000
VAULT_MAX_ATTEMPTS=3
# Production external mode requires all three explicit egress allowlists.
# Private vault networks are allowed only when their real host/port/CIDR are listed.
VAULT_EGRESS_HOST_ALLOWLIST=
VAULT_EGRESS_PORT_ALLOWLIST=
VAULT_EGRESS_CIDR_ALLOWLIST=

# --- Supplier (provider-neutral rollout gates) ---
SUPPLIER_PURCHASE_ENABLED=false
SUPPLIER_AUTO_FAILOVER_ENABLED=false

# --- QCST (Vault-backed; all rollout gates disabled by default) ---
QCST_PROVIDER_ENABLED=false
QCST_CATALOG_SYNC=false
QCST_ADMIN_PRODUCT_BROWSER=false
QCST_OWNER_SELECTION=false
QCST_LOCAL_PRICE_CONTROL=false
QCST_PURCHASE_ENABLED=false
QCST_API_BASE_URL=https://api.qcst.tech
QCST_API_KEY_VAULT_REF=
QCST_TIMEOUT_MS=8000

# --- Vô Không (health-only; all rollout gates disabled by default) ---
VOKHONG_PROVIDER_ENABLED=false
VOKHONG_CATALOG_SYNC=false
VOKHONG_ADMIN_PRODUCT_BROWSER=false
VOKHONG_OWNER_SELECTION=false
VOKHONG_LOCAL_PRICE_CONTROL=false
VOKHONG_PURCHASE_ENABLED=false
VOKHONG_API_BASE_URL=https://vokhong.xyz/api
VOKHONG_API_KEY_VAULT_REF=
VOKHONG_TIMEOUT_MS=8000
# --- Search parser (AI is optional, bounded filter output only) ---
SEARCH_PARSER_DRIVER=deterministic
SEARCH_PARSER_TIMEOUT_MS=1500

# Google Sheets stays opt-in. Owner is the Google account email used for protected Requests input cells.
GOOGLE_SHEETS_ENABLED=false
# Set true only after migration, Apps Script owner/OIDC setup and live acceptance.
GOOGLE_SHEETS_INVENTORY_INTAKE_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIAL_VAULT_REF=
GOOGLE_SHEETS_OWNER_ID=
# Apps Script OIDC audience/client id; required when intake is enabled.
GOOGLE_SHEETS_OIDC_AUDIENCE=
GOOGLE_SHEETS_TIMEOUT_MS=5000
GOOGLE_SHEETS_MAX_ATTEMPTS=3
GOOGLE_SHEETS_SYNC_INTERVAL_MS=60000


# --- AI support (OpenAI-compatible Responses API; never commit real key) ---
AI_SUPPORT_ENABLED=false
AI_PROVIDER=9router
AI_API_BASE_URL=https://qrouter.online/v1
AI_API_KEY=
AI_MODEL=cx/gpt-5.6-terra
AI_WIRE_API=responses
AI_REASONING_EFFORT=low
AI_VERBOSITY=low
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=600
AI_RATE_LIMIT_PER_MINUTE=20

# --- Outbox worker ---
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=10
